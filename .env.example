# Optional overrides. Copy to .env and explicitly source it before native startup.
# .env is ignored by Git. Never place a real token in this example file.
# WECHAT_HOME=/absolute/path/to/this/checkout
# WECHAT_PANEL_PORT=8080
# WECHAT_HOOK_PORT=36060
# WECHAT_PYTHON=python3
# WECHAT_APP=/Applications/WeChat.app
# WECHAT_CONFIG=/absolute/path/to/this/checkout/onebot/wechat_version/4_1_12_53_mac.json
# WECHAT_ONEBOT_TOKEN=  # When unset, native startup generates a local random token.
